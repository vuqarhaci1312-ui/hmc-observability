# Production environment template.
# Supply secrets from the environment or a secret manager.
# Do not create a demo admin in production. Leave DEMO_ADMIN_* empty.

APP_ENV=production
APP_NAME=HMC Observability Control Center
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
CORS_ORIGINS=https://observability.example.com

POSTGRES_USER=hmc
POSTGRES_PASSWORD=
POSTGRES_DB=hmc
DATABASE_URL=postgresql+asyncpg://hmc:PASSWORD@postgres:5432/hmc

REDIS_URL=redis://redis:6379/0
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

HTTP_PORT=8080
RUN_MIGRATIONS=1

DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_RANDOM_SEED=42
DEMO_PROFILE=quick

INGEST_MAX_BATCH=2000
INGEST_MAX_BODY_BYTES=5000000
RATE_LIMIT_PER_MINUTE=2000
LOG_RETENTION_HOURS=2160
METRIC_RETENTION_DAYS=180
