# Copy to .env before `docker compose up`.
# Replace every placeholder. Do not commit .env.

APP_ENV=development
APP_NAME=HMC Observability Control Center
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

POSTGRES_USER=hmc
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=hmc
DATABASE_URL=postgresql+asyncpg://hmc:replace-with-a-strong-password@postgres:5432/hmc

REDIS_URL=redis://redis:6379/0

LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

HTTP_PORT=8080
RUN_MIGRATIONS=1

# Development seed only. Leave empty in production.
DEMO_ADMIN_EMAIL=admin@hmc.local
DEMO_ADMIN_PASSWORD=replace-with-a-development-password
DEMO_RANDOM_SEED=42
DEMO_PROFILE=quick

INGEST_MAX_BATCH=1000
INGEST_MAX_BODY_BYTES=2000000
RATE_LIMIT_PER_MINUTE=600
LOG_RETENTION_HOURS=720
METRIC_RETENTION_DAYS=90
